---
// src/components/AutoLink.astro
import { SITE_URL } from '../consts.ts';

const { href, target, rel, ...props } = Astro.props;

// Safely determine host matching even during local dev
let isExternal = false;
try {
  const linkUrl = new URL(href, SITE_URL);
  const siteUrl = new URL(SITE_URL);
  isExternal = linkUrl.origin !== siteUrl.origin;
} catch {
  isExternal = false;
}

const isPdf = href?.toLowerCase().endsWith('.pdf');

const finalTarget = target || (isExternal || isPdf ? "_blank" : undefined);
const finalRel = rel || (isExternal ? "noopener noreferrer" : undefined);
---

<a href={href} rel={finalRel} target={finalTarget} {...props}><slot /></a>

---
// components/WideHeader.astro
import { Image } from 'astro:assets';
import desktopBird from '../assets/images/quaker_icon_95x95.avif'
import siteConfig from '../data/site-config.json';
import { BIRD_ANIMATIONS } from '../consts';
// 1. Get props from parent (Navigation.astro)
const { lang, homelink, translationID } = Astro.props;

const getAnim = (category, id) => {
  const animations = BIRD_ANIMATIONS[category];
  const match = Object.keys(animations).find(className =>
    animations[className].includes(id)
  );
  return match || '';
};

const isFr = lang === 'fr';

const siteTitle = isFr ? siteConfig.title_fr : siteConfig.title;

// Resolve specific animation classes
const leftBirdClass = getAnim('left', translationID);
const rightBirdClass = getAnim('right', translationID);
const headerClass = getAnim('header', translationID);



console.log('--- WideHeader Debug ---');
console.log('Current ID:', translationID);
console.log('Type of ID:', typeof translationID);
---

<div>
  <a class="linkoff wideheader" href={homelink}>
    <Image 
      alt="top left bird logo" 
      class={`logo noback ${leftBirdClass}`}
      data-key={translationID}
      src={desktopBird}
      width="95" 
      height="95"
    />

    <span class={`wideheader__text noback ${headerClass}`}>
      {siteTitle}
    </span>

    <Image  
      alt="top right bird logo" 
      class={`bird noback ${rightBirdClass}`}
      data-key={translationID}
      src={desktopBird}
      width="95" 
      height="95"
    />
  </a>
</div>
<script is:inline define:vars={{ translationID, leftBirdClass, headerClass }}>
  console.log("--- WideHeader Browser Debug ---");
  console.log("ID received from Props:", translationID);
  console.log("Class calculated for Left:", leftBirdClass);
  console.log("Class calculated for Header:", headerClass);
</script>

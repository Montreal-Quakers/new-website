---
// components/WideHeader.astro
import { Image } from 'astro:assets';
import desktopBird from '../assets/images/quaker_icon_95x95.avif'
import siteConfig from '../data/site-config.json';
// 1. Get props from parent (Navigation.astro)
const { lang, homelink } = Astro.props;

// 2. Fetch animation data (Replacing site.bird_left, etc.)
// In a real setup, you could import these from a JSON file in src/data/
const birdLeftData = [
  { translationID: 'home', animation: 'fly-in' },
  { translationID: 'about', animation: 'bounce' }
];
const headerAnimData = [
  { translationID: 'home', animation: 'fade-in' }
];
const birdRightData = [
  { translationID: 'contact', animation: 'spin' }
];

// 3. Helper to find the correct animation class
const getAnim = (list, id) => {
  const match = list.find(item => item.translationID === id);
  return match ? match.animation : '';
};

const translationID = Astro.props.translationID; // Passed down from Layout
const isFr = lang === 'fr';

const siteTitle = isFr ? siteConfig.title_fr : siteConfig.title;

// Resolve specific animation classes
const leftBirdClass = getAnim(birdLeftData, translationID);
const headerClass = getAnim(headerAnimData, translationID);
const rightBirdClass = getAnim(birdRightData, translationID);
---

<div>
  <a class="linkoff wideheader" href={homelink}>
    <Image 
      alt="top left bird logo" 
      class={`logo noback ${leftBirdClass}`}
      src={desktopBird}
      width="95" 
      height="95"
    />

    <span class={`wideheader__text noback ${headerClass}`}>
      {siteTitle}
    </span>

    <Image  
      alt="top right bird logo" 
      class={`bird noback ${rightBirdClass}`}
      src={desktopBird}
      width="95" 
      height="95"
    />
  </a>
</div>

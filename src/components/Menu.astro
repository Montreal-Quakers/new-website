---
import { Icon } from 'astro-icon/components';
import LanguageChanger from './navigation/LanguageChanger.astro';
import SearchForm from './menu-buttons/SearchForm.astro';
import navData from '../data/navigation.json';

const { lang, homelink, homename, iconLeft, iconRight, breakpoints } = Astro.props;
const currentPath = Astro.url.pathname;

const doclist = lang === 'fr' ? navData.fr : navData.en;
const thislang = lang;

const isActive = (link: any) => {
  const decodedPath = decodeURIComponent(currentPath);
  return link === decodedPath || (link === '/' && decodedPath === homelink);
};
---

<nav class="navbar" id="myNavbar" data-breakpoint={breakpoints}>
  <ul>
    {/* 0. Page-Specific Left Icon (e.g., Pencil) */}
    {iconLeft && (
      <li class="nav-deco-left">
        <Icon name={iconLeft} style="width: 1.2em; height: 1.2em; margin-top: 10px;" />
      </li>
    )}

    {/* 1. Wide Home Icon */}
    <li>
      <a 
        id="widehome" 
        aria-label={homename}
        class={isActive(homelink) ? "active" : ""} 
        href={homelink} 
        title={homename}
      >
        <Icon name="fa-solid:home" class="home" />
      </a>
    </li>      

    {/* 2. Narrow Home Label */}
    <li>
      <a 
        id="narrowhome" 
        class={isActive(homelink) ? "active" : ""}
        href={homelink} 
        title={homename} 
        aria-label={homename}
      >
        {homename} <Icon name="fa-solid:home" style="width: 1em; display: inline;" />
      </a>
    </li>

    {/* 3. The Main Navigation Loop */}
    {doclist.map((item, index) => {
      const counter = index + 1;
      const uniqueID = `${thislang}${counter}`;

      if (item.submenu) {
        return (
          <li 
            class={`dropdown dropdown-${uniqueID}-container`}
          >
            <button class="dropbtn" title={item.hovertitle}>
              <Icon name="fa-solid:caret-right" id={`caret_${uniqueID}`} class="caret" />
              {item.title}
              {item.icon && <Icon name={item.icon} />}
            </button>

            <div class="dropdown-menu">
              <ul id={`dropdown_${uniqueID}`} class="dropdown-content">
                {item.submenu.map((subitem) => (
                  <li>
                    <a 
                      href={subitem.sublink} 
                      title={subitem.subhovertitle}
                      class={isActive(subitem.sublink) ? "active" : ""}
                    >
                      {subitem.subicon && <Icon name={subitem.subicon} />}
                      {subitem.subtitle}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      }

      return (
        <li>
          <a 
            href={item.link} 
            title={item.hovertitle}
            class={isActive(item.link) ? "active" : ""}
          >
            {item.title} {item.icon && <Icon name={item.icon} />}
          </a>
        </li>
      );
    })}

    {/* 4. Language Changer & Search */}
    <LanguageChanger lang={lang} />
    <SearchForm lang={lang} />

    {/* 5. Page-Specific Right Icon (e.g., Phone) */}
    {iconRight && (
      <li class="nav-deco-right">
        <Icon name={iconRight} />
      </li>
    )}
  </ul>
</nav>

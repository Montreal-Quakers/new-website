---
// src/components/ContactForm.astro
import { Icon } from 'astro-icon/components';

const { lang } = Astro.props;

const labels = lang === "fr" ? {
  name: "Nom",
  email: "Courriel",
  subject: "Objet",
  message: "Message",
  envoyer: "Envoyer",
  code: "fr"
} : {
  name: "Name",
  email: "Email",
  subject: "Subject",
  message: "Message",
  envoyer: "Send Message",
  code: "en"
};
---

<form 
  action="https://formspree.io/xzbjggnl" 
  method="POST" 
  target="_blank"
  class="contact-form"
>
  <p>
    <input 
      aria-label={labels.name}
      class="w3-input w3-border" 
      type="text" 
      placeholder={labels.name}
      required 
      name="Name"
    />
  </p>
  
  <p>
    <input 
      aria-label={labels.email}
      class="w3-input w3-border" 
      type="email" 
      placeholder={labels.email}
      required 
      name="Email"
    />
  </p>
  
  <p>
    <input 
      aria-label={labels.subject} 
      class="w3-input w3-border" 
      type="text" 
      required 
      placeholder={labels.subject} 
      name="Subject"
    />
  </p>
  
  <p>
    <textarea 
      aria-label={labels.message} 
      class="w3-input w3-border" 
      placeholder={labels.message} 
      required 
      name="Message"
    ></textarea>
  </p>
  
  <input type="hidden" name="_language" value={labels.code} />
  
  <p>
    <button 
      aria-label={labels.envoyer} 
      class="w3-button color-1-dark" 
      type="submit"
    >
      <Icon name="fa-solid:paper-plane" style="width: 1em; height: 1em; display: inline-block; vertical-align: middle;" /> &nbsp;
      {labels.envoyer.toUpperCase()}
    </button>
  </p>
</form>

<style>
  .contact-form input, 
  .contact-form button, 
  .contact-form select, 
  .contact-form textarea {
    font: inherit;
    width: 100%;
    border-radius: 6px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-1-dark);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
  }

  .contact-form textarea {
    min-block-size: 3lh;
    field-sizing: content;
    resize: vertical;
  }

  .contact-form button {
    width: auto;
    border-radius: 12px;
  }
</style>

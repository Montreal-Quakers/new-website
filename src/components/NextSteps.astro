---
// src/components/NextSteps.astro
import { Icon } from 'astro-icon/components';
import newcomerCards from '../data/newcomer_cards.json';

const { lang } = Astro.props;
const cards = lang === 'fr' ? newcomerCards.fr : newcomerCards.en;
---

<section class="cards" id="cards">
  <ul>
    {cards.map((card, index) => (
      <li class={`fade ${index % 2 === 0 ? 'fadeOutLeft' : 'fadeOutRight'}`}>
        <a href={card.link} title={card.hovertitle} class="linkoff">
          {card.title} &nbsp; 
          {card.icon && <Icon name={card.icon} style="width: 1em; display: inline;" />}
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  function setupAnimations() {
    const observerOptions = { threshold: 0.1 };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          if (target.classList.contains('fadeOutLeft')) {
            target.classList.add('fadeInLeft');
            target.classList.remove('fadeOutLeft');
          } else if (target.classList.contains('fadeOutRight')) {
            target.classList.add('fadeInRight');
            target.classList.remove('fadeOutRight');
          }
          target.style.opacity = "1";
          observer.unobserve(target);
        }
      });
    }, observerOptions);

    // Only target items within the current page view
    document.querySelectorAll('.cards li').forEach(li => observer.observe(li));
  }

  // Runs on initial load
  setupAnimations();

  // Runs every time a View Transition completes
  document.addEventListener('astro:page-load', setupAnimations);
</script>

<style lang="scss">
@use '../styles/_colors';
// @import 'variables';
$height: 8rem;

.container-content {
  flex-direction: column;
  max-width: colors.$text-width;
  box-sizing: border-box;
}

.content {
  flex: 0 1 auto;
  width: 100%;
}

.content p {
  max-width: colors.$text-width;
  margin-inline: auto;

}

.content ol,
.content ul {
  max-width: 50em;
  margin-inline: auto;
}

.cards,
.posts {
  padding: 1rem
}

.cards {
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
ul {
    max-width: 700px; // Or your preferred max width for the grid
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    grid-gap: 1rem;
    list-style-type: none;
    padding: 0 1rem;
  }
}

.cards>ul,
.posts>ul {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  // grid-template-rows: repeat(auto-fit, minmax($height,1fr));
  // grid-auto-flow: dense;
  grid-gap: 1rem;
  list-style-type: none;
  // justify-content: center;
  margin: auto;
  padding: 0;
}

// Index and newcomer cards
.cards>ul>li {

  // Used to create left-to-right colors on these cards
  // border-radius: .5rem;
  // position: relative;
  // //z-index: -10;
  // &::before {
  //   content: '';
  //   position: absolute;
  //   border-radius: .5rem;
  //   inset: 0;
  //   background-color: var(--card-color);
  //   z-index: -2;
  //   }
  &>a:first-child {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: colors.$font-serif;
    font-size: 1.5rem;
    border-radius: .5rem;
    cursor: pointer;
    height: $height;
    overflow: hidden;
    box-shadow: 0px 2px 3px 0 rgba(0, 0, 0, var(--card-shadow));
    background-color: var(--card-color);
    transition: box-shadow 0.3s, background 0.3s;

    &:hover {
      box-shadow: 1px 3px 8px 0 rgba(0, 0, 0, var(--card-hover-shadow));
      background-color: var(--card-hover);
    }
  }
}


.posts>ul>li {
  position: relative;
  border-radius: .5rem;
  cursor: pointer;
  overflow: hidden;
  box-shadow: 0px 2px 2px rgba(0, 0, 0, var(--card-shadow));
  // margin: auto;
  color: var(--body-text);

  &:hover {
    box-shadow: 1px 3px 7px rgba(0, 0, 0, var(--card-shadow));
  }

  &::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -3;
    background-color: var(--card-color);
  }

  &:hover .post-card h3::before {
    transform: translateX(0);
  }
}

.post-card {
  position: relative;

  &::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--card-header);
  }

  h3 {
    position: relative;
    font-family: colors.$font-serif;
    // background-color: var(--card-header);
    background-color: transparent;
    text-align: center;
    margin: 0;
    padding: 15px;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background-color: var(--card-hover);
      @media (prefers-reduced-motion: no-preference) {
        transform: translateX(-100%);
        transition: transform 0.45s ease;
      }
      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }
  }
}

.post-container {
  width: 100%;

  h5 {
    font-family: colors.$font-serif;
    margin: 0;
    padding: 15px;
    text-indent: 5px;
    transition: background .3s;
  }

  p:first-child {
    margin: 0;
    text-indent: 0px
  }

  padding: 15px;

  p,
  a,
  span {
    text-decoration: none;
  }

  .decorate_link {
    text-decoration: underline var(--color-1);
  }
}
  .fadeOutRight {
    opacity: 0;
  }

  .fadeOutLeft {
    opacity: 0;
  }

  .fadeInLeft {
    animation-name: moveInLeft;
    animation-duration: 0.3s;
    //  transform: translate(1em,0)
  }

  .fadeInRight {
    animation-name: moveInRight;
    animation-duration: 0.3s;
    //  transform: translate(-1em,0)
  }

  @keyframes moveInRight {
    0% {
      opacity: 0.25;
      transform: translate(4em);
    }

    100% {
      opacity: 1;
      left: 0;
    }
  }

  @keyframes moveInLeft {
    0% {
      opacity: 0.25;
      transform: translate(-4em);
    }

    100% {
      opacity: 1;
      left: 0;
    }
  }

</style>

---
import { Icon } from 'astro-icon/components';
import WideHeader from './navigation/WideHeader.astro';
import Menu from './Menu.astro';
import NarrowHeader from './navigation/NarrowHeader.astro';
import Breadcrumbs from './navigation/Breadcrumbs.astro';

// 1. Setup variables
const { lang = 'en', translationID, series, iconLeft, iconRight, breakpoints } = Astro.props;
const url = Astro.url.pathname; 

const isFr = lang === 'fr';
const homename = isFr ? "Accueil" : "Home";
const homelink = isFr ? "/accueil" : "/home";

// 2. Clean Path Logic[cite: 3, 7]
// decodeURIComponent handles the %C3 encoding, and normalize('NFC') standardizes the 'é'
const currentPath = decodeURIComponent(url).normalize('NFC').replace(/\/$/, ""); 

const isNextStepsPage = currentPath.startsWith("/next_steps") && currentPath !== "/next_steps";
const isEtapeSuivantePage = currentPath.startsWith("/étape_suivante") && currentPath !== "/étape_suivante";

const showBreadcrumbs = 
  isNextStepsPage || 
  isEtapeSuivantePage ||
  translationID === "privacy" || 
  translationID === "livres-français" || 
  series === "history";
---
<div class="nav-container">
  <input type="checkbox" id="nav-toggle" title="Dropdown menu" class="nav-toggle" />

  <NarrowHeader 
    lang={lang} 
    homelink={homelink}
    translationID={translationID}
  />

  <WideHeader 
    lang={lang} 
    homename={homename} 
    homelink={homelink} 
    translationID={translationID} 
    series={series}
  />

  <div class="intersectionObserver" id="intersectionObserver2">&nbsp;</div>

  <Menu 
    lang={lang} 
    homelink={homelink} 
    homename={homename} 
    iconLeft={iconLeft} 
    iconRight={iconRight} 
    breakpoints={breakpoints}
    class="navbar"
    id="myNavbar"
  />
</div>

<div class="intersectionObserver" id="intersectionObserver1">&nbsp;</div>

{showBreadcrumbs && <Breadcrumbs lang={lang} translationID={translationID} series={series} />}

---
// 1. Get the lang from Astro.props (passed down from Layout -> Dispatcher)
const { lang = 'en' } = Astro.props;
const isFr = lang === 'fr';

// 2. Import the transcripts
// We use the ?raw suffix or just import them as components if they are .md files
import { Content as TranscriptEn } from './YouTubeEmbedTranscript.mdx';
import { Content as TranscriptFr } from './YouTubeEmbedTranscriptFR.mdx';

// 3. Handle the image path (assuming it's in your assets now)
import { Image } from 'astro:assets';
import ytLazyLoad from '../../assets/images/yt_lazy_load.jpg';
---

<div class='embed-container'>
  <div id="yt-placeholder" class="embed-container">
    <Image src={ytLazyLoad} alt="Video thumbnail" fetchpriority="high"/>
    <button class="play-button" aria-label="Play Video">▶</button>
  </div>
  <template id="yt-template">
    <iframe 
      title="Video: what to expect in a Quaker meeting for worship" 
      src='https://www.youtube-nocookie.com/embed/hxjH4sa2RFI?autoplay=1' 
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
      allowfullscreen>
    </iframe>
  </template>
</div>

<details>
  <summary>
    {isFr ? "Transcription" : "Transcript"}
  </summary>
  <div class="transcript-content">
    {isFr ? <TranscriptFr /> : <TranscriptEn />}
  </div>
</details>

<script>
  document.addEventListener('astro:page-load', () => {
    const placeholder = document.getElementById('yt-placeholder');
    const template = document.getElementById('yt-template') as HTMLTemplateElement;

    placeholder?.addEventListener('click', () => {
      const content = template.content.cloneNode(true);
      placeholder.innerHTML = '';
      placeholder.appendChild(content);
    });
  });
</script>
<style>
  .video-wrapper { position: relative; width: 100%; cursor: pointer; }
  .embed-container {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    background: #000;
  }
  .embed-container img {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .play-button {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    font-size: 48px; color: white; background: rgba(0,0,0,0.6); border: none; border-radius: 50%;
    width: 80px; height: 80px; cursor: pointer;
  }
  /* Style your iframe to fill the container once injected */
  :global(.embed-container iframe) {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;
  }
</style>

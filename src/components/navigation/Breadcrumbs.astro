---
import newcomerData from '../../data/newcomer_cards.json';

const { lang, translationID, series } = Astro.props;
const isFr = lang === 'fr';

// Use URL for the raw path, then decode it
const currentPath = decodeURIComponent(Astro.url.pathname);

// 1. Define Static Breadcrumb Data
const paths = {
  privacy: {
    link: isFr ? "/contact-fr" : "/contact",
    parent: isFr ? "Contact" : "Contact Us",
    current: isFr ? "Politique de confidentialité" : "Privacy Policy"
  },
  history: {
    link: isFr ? "/liens_histoire" : "/links_history",
    parent: isFr ? "Liens & histoire" : "Links & History",
    current: translationID === "livres-français" 
      ? (isFr ? "Sélection de livres en français" : "Selection of books in French")
      : (isFr ? "Histoire des quakers au Québec" : "History of Quakers in Québec")
  },
  default: {
    link: isFr ? "/étape_suivante" : "/next_steps",
    text: isFr ? "Étape suivante" : "Next steps"
  }
};

// 2. Enhanced Normalization Logic
const normalize = (path : any) => {
  if (!path) return "";
  return path
    .toLowerCase()
    .replace(/\/$/, "")       // Remove trailing slash
    .replace(/^\//, "")       // Remove leading slash for consistency
    .normalize("NFC")         // Force Canonical Composition
    .trim();
};

const normalizedCurrent = normalize(currentPath);

let breadcrumbs: any = [];

if (translationID === "privacy") {
  breadcrumbs = [paths.privacy];
} else if (translationID === "livres-français" || series === "history") {
  breadcrumbs = [paths.history];
} else {
  const doclist = isFr ? newcomerData.fr : newcomerData.en;
  
  doclist.forEach(item => {
    const normalizedItemLink = normalize(item.link);
    
    // Debug comparison for top-level items
    if (isFr) console.log(`Comparing: "${normalizedItemLink}" === "${normalizedCurrent}"`);

    if (normalizedItemLink === normalizedCurrent) {
      console.log("MATCH FOUND: Top level");
      breadcrumbs.push({ parent: paths.default.text, link: paths.default.link, current: item.title });
    }
    
    if (item.submenu) {
      const subMatch = item.submenu.find(sub => {
        const nSub = normalize(sub.sublink);
        const match = nSub === normalizedCurrent || (nSub.length > 0 && normalizedCurrent.endsWith(nSub));
        if (match && isFr) console.log(`MATCH FOUND: Submenu item "${sub.subtitle}"`);
        return match;
      });

      if (subMatch) {
        breadcrumbs.push({ parent: paths.default.text, link: paths.default.link });
        breadcrumbs.push({ parent: item.title, link: item.link, current: subMatch.subtitle });
      }
    }
  });
}
---
<ul class="breadcrumb">
  {breadcrumbs.map((crumb: any, index: any) => (
    <>
      {crumb.link && (
        <li>
          <a href={crumb.link} class="crumblink">{crumb.parent || crumb.text}</a>
        </li>
      )}
      {crumb.current && <li>{crumb.current}</li>}
    </>
  ))}
</ul>

<style>
  a.crumblink, a.crumblink:visited {
    color: var(--body-text)
  }
</style>

---
// src/components/CodeAlert.astro
import { getEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import CloseButton from '../menu-buttons/CloseButton.astro';
import { ALERTS } from '../../consts';

const { lang, translationID } = Astro.props;
const isFr = lang === 'fr';

async function getAlertId(color: any) {
  const config = ALERTS[color];
  if (!config || config.status === "off") return null;

  if (config.status === "all") {
    return isFr ? config.all_fr : config.all_en;
  }

  if (config.status === "some" && config.pages) {
    const match = config.pages.find(p => p.tid === translationID);
    if (match) {
      return isFr ? match.fr : match.en;
    }
  }
  return null;
}

// Fetch Red Alert
const redId = await getAlertId('red');
const redEntry = redId ? await getEntry('alerts', redId) : null;
const renderedRed = redEntry ? await render(redEntry) : null;
const RedContent = renderedRed?.Content;

// Fetch Blue Alert
const blueId = await getAlertId('blue');
const blueEntry = blueId ? await getEntry('alerts', blueId) : null;
const renderedBlue = blueEntry ? await render(blueEntry) : null;
const BlueContent = renderedBlue?.Content;
---

<div class="container-alert">
  {RedContent && (
    <div class="stickystart redalert">
      <div></div>
      <div class="alert">
        <Icon name="exclamation-circle" class="alert-icon" />
        <div class="alert-text"><RedContent /></div>
      </div>
      <CloseButton />
    </div>
  )}

  {BlueContent && (
    <div class="stickystart bluealert">
      <div></div>
      <div class="alert">
        <Icon name="fa7-solid:info-circle" class="alert-icon" />
        <div class="alert-text"><BlueContent /></div>
      </div>
      <CloseButton />
    </div>
  )}
</div>

<style>
  .alert-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }
  .alert {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .alert-text :global(p) {
    display: inline; /* Keeps markdown paragraphs from breaking layout */
    margin: 0;
  }
</style>

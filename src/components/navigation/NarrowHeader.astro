---
// src/components/navigation/NarrowHeader.astro
import { Image } from 'astro:assets';
import mobileBird from '../../assets/images/quaker_icon_35x35.avif'
import siteConfig from '../../data/site-config.json';
import { BIRD_ANIMATIONS } from '../../consts';
// 1. Get props
const { lang, homename, translationID } = Astro.props;

// 2. Define mobile-specific animation data (from your navigation.json or _config.yml)
const getAnim = (category, id) => {
  const animations = BIRD_ANIMATIONS[category];
  if (!animations) return '';
  const match = Object.keys(animations).find(className =>
    animations[className].includes(id)
  );
  return match || '';
};

const isFr = lang === 'fr';
const shortTitle = isFr ? siteConfig.short_title_fr : siteConfig.short_title;

const homelink = isFr ? "/accueil" : "/home";
const defaultHomeName = isFr ? "Accueil" : "Home";
const finalHomeName = homename || defaultHomeName;

// Fallback checks 'right', 'mobile', or 'header' categories in BIRD_ANIMATIONS
const birdAnimClass = getAnim('mobile', translationID) || getAnim('right', translationID);
const headerAnimClass = getAnim('mobileHeader', translationID) || getAnim('header', translationID);
---

<div id="narrowheader">
  <label for="nav-toggle" class="nav-toggle-label">
    <span></span>
  </label>

  <a 
    href={homelink} 
    class={`linkoff ${headerAnimClass}`}
  >
    {shortTitle}
  </a>

  <div class="logo logo__mobile">
    <a title={homename} href={homelink}>
      <Image  
        alt="top right bird logo" 
        class={birdAnimClass}
        src={mobileBird}
        width="35" 
        height="35"
      />
    </a>
  </div>
</div>

<style>
#narrowheader a, #narrowheader a:visited {
    color: var(--alert-text);
  }
</style>

---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const { lang = 'en', translationID, translatedUrl } = Astro.props;

const targetLang = lang === 'en' ? 'fr' : 'en';
const label = lang === 'en' ? 'Français' : 'English';

let targetPath = translatedUrl || null;

if (!targetPath) {
  // 1. Special case for publications/news route
  if (translationID === 'news') {
    targetPath = `/publications/${targetLang}`;
  } 
  // 2. Look up in both 'pages' and 'blog' collections
  else if (translationID) {
    const allPages = await getCollection('pages');
    const allBlog = await getCollection('blog');

    const sisterBlog = allBlog.find(doc => 
      doc.data?.translationID === translationID && 
      (doc.data?.lang || 'en') === targetLang
    );

    const sisterPage = allPages.find(doc => 
      doc.data?.translationID === translationID && 
      (doc.data?.lang || 'en') === targetLang
    );

    if (sisterBlog) {
      targetPath = `/publications/${sisterBlog.id}`;
    } else if (sisterPage) {
      const cleanId = sisterPage.id.replace(/\.(mdx|md)$/, '').replace(/\/index$/, '');
      targetPath = cleanId === 'index' ? '/' : `/${cleanId}`;
    }
  }
}
---

{targetPath && (
  <li>
    <a 
      id="languageChanger" 
      href={targetPath} 
      data-newurl={targetPath} 
      onclick="flipIcon(event)" 
      title={label} 
      class="linkoff"
    >
      <span class="wide-lang">{label}</span>
      &nbsp;<Icon name="fa-solid:random" id="twoArrowIcon" />
    </a>
  </li>
)}

<style>
  .linkoff svg {
    margin-left: 0.8ch;
    vertical-align: sub;
  }
</style>

---
// components/DarkModeToggle.astro
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const isFr = lang === 'fr';
const label = isFr ? "Basculer en mode sombre" : "Toggle Dark Mode";
---
<button 
  id="dark-mode-toggle" 
  class="dark-mode-toggle" 
  title={label} 
  aria-label={label}
>
  {/* Using your existing SVG path logic, but wrapped in an Astro-friendly way */}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 496">
    <path 
      fill="currentColor" 
      d="M8,256C8,393,119,504,256,504S504,393,504,256,393,8,256,8,8,119,8,256ZM256,440V72a184,184,0,0,1,0,368Z" 
      transform="translate(-8 -8)" 
    />
  </svg>
</button>

<style lang="scss">
  .dark-mode-toggle {
    background: none;
    border: 2px solid currentColor;
border-radius: 5px;
    cursor: pointer;
    padding: 0;
    width: 36px;
    height: 36px;
    color: var(--color-1-dark-text);
    margin-left: 2ch;
    
    svg {
      display: block;
      width: 100%;
      height: 100%;
      padding: 6px;
    }

    &:hover {
      opacity: 0.8;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import navData from '../data/navigation.json';
const welcomeLinks = navData.welcome;
---

<Layout translationID="index-choose" lang="en">
  <section class="cards cards_index" id="cards">
    <ul id="this">
      {welcomeLinks.map((each) => (
        <li>
          <a 
            role="button"
            tabindex="0"
            style="cursor: pointer;"
            class="linkoff"
            
            onclick={`chooseLang('${each.lang}', '${each.link}')`}
            onkeypress={`if(event.key === 'Enter') chooseLang('${each.lang}', '${each.link}')`}
          >
            <span>{each.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script>
    // Import the setup function from your assets
    import { setupLangChoice } from '../assets/js/lang-choose.js';

    // This ensures that even with View Transitions, 
    // any initialization in your JS file runs on every "swapped" page.
    document.addEventListener('astro:page-load', () => {
      setupLangChoice();
    });
  </script>
</Layout>


  <style lang="scss">
@use '../styles/_colors';
// @import 'variables';
$height: 8rem;

.container-content {
  flex-direction: row;
  max-width: colors.$text-width;
  box-sizing: border-box;
}

.content {
  flex: 0 1 auto;
  width: 100%;
}

.content p {
  max-width: colors.$text-width;
  margin-inline: auto;

}

.content ol,
.content ul {
  max-width: 60em;
  margin-inline: auto;
}

.cards,
.posts {
  padding: 1rem
}

.cards>ul,
.posts>ul {
  display: grid;
  grid-template-columns: 1fr;
  // grid-template-rows: repeat(auto-fit, minmax($height,1fr));
  // grid-auto-flow: dense;
  grid-gap: 1rem;
  list-style-type: none;
  // justify-content: center;
  margin: auto;
  padding: 0;
}

@media (min-width: 900px){
.cards.cards_index>ul,#this {
      grid-template-columns: 1fr 1fr;
  } 
}

// Index and newcomer cards
.cards>ul>li {

  // Used to create left-to-right colors on these cards
  // border-radius: .5rem;
  // position: relative;
  // //z-index: -10;
  // &::before {
  //   content: '';
  //   position: absolute;
  //   border-radius: .5rem;
  //   inset: 0;
  //   background-color: var(--card-color);
  //   z-index: -2;
  //   }
  &>a:first-child {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: colors.$font-serif;
    font-size: 1.5rem;
    text-decoration: none;
    text-align: center;
    border-radius: .5rem;
    cursor: pointer;
    height: $height;
    overflow: hidden;
    box-shadow: 0px 2px 3px 0 rgba(0, 0, 0, var(--card-shadow));
    margin: auto;
    padding: 10px;
    background-color: var(--card-color);
    transition: box-shadow 0.3s, background 0.3s;

    &:hover {
      box-shadow: 1px 3px 8px 0 rgba(0, 0, 0, var(--card-hover-shadow));
      background-color: var(--card-hover);
    }
  }
}


.posts>ul>li {
  position: relative;
  border-radius: .5rem;
  cursor: pointer;
  overflow: hidden;
  box-shadow: 0px 2px 2px rgba(0, 0, 0, var(--card-shadow));
  // margin: auto;
  color: var(--body-text);

  &:hover {
    box-shadow: 1px 3px 7px rgba(0, 0, 0, var(--card-shadow));
  }

  &::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -3;
    background-color: var(--card-color);
  }

  &:hover .post-card h3::before {
    transform: translateX(0);
  }
}

.post-card {
  position: relative;

  &::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--card-header);
  }

  h3 {
    position: relative;
    font-family: colors.$font-serif;
    // background-color: var(--card-header);
    background-color: transparent;
    text-align: center;
    margin: 0;
    padding: 15px;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background-color: var(--card-hover);
      transform: translateX(-100%);
      transition: transform 0.45s ease;
    }
  }
}

.post-container {
  width: 100%;

  h5 {
    font-family: colors.$font-serif;
    margin: 0;
    padding: 15px;
    text-indent: 5px;
    transition: background .3s;
  }

  p:first-child {
    margin: 0;
    text-indent: 0px
  }

  padding: 15px;

  p,
  a,
  span {
    text-decoration: none;
  }

  .decorate_link {
    text-decoration: underline var(--color-1);
  }
}
    .cards_index>ul>li>a:first-child {
      //  display: inline-block;
      //transition: background 0.5s;
      font-size: 2.0em;

      //  &:hover {
      //         background-color: var(--card-hover)
      //  }
      &:hover span {
        padding-right: 15px;
      }

      &:hover span:after {
        opacity: 1;
        right: 0;
      }

      span {
        position: relative;
        transition: 0.5s;
        right: -10px;
      }

      span:after {
        content: '\00a0\00a0 \00bb';
        opacity: 0;
        top: 0;
        right: -25px;
        transition: 0.5s;
      }
    }
  </style>

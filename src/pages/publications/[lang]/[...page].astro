---
// src/pages/publications/[lang]/[...page].astro
// This is the publications list page (in both English and French)
// (i.e. this page lays out a bunch of cards to choose from)
import Layout from '../../../layouts/Layout.astro';
import AutoLink from '../../../components/AutoLink.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

// Dynamically import images from src/assets
const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{avif,jpg,jpeg,png,webp,svg}', 
  { eager: true }
);

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('blog');
  const languages = ['en', 'fr'];

  const getPostDate = (post) => {
    if (post.data.pubDate) return post.data.pubDate.getTime();
    const match = post.id.match(/^(\d{4}-\d{2}-\d{2})/);
    return match ? new Date(match[1]).getTime() : 0;
  };

  const sortedPosts = allPosts.sort((a, b) => getPostDate(b) - getPostDate(a));

  return languages.flatMap((lang) => {
    const filteredPosts = sortedPosts.filter((post) =>
      lang === 'fr' ? post.data.lang === 'fr' : post.data.lang !== 'fr'
    );

    return paginate(filteredPosts, {
      params: { lang },
      pageSize: 6,
    });
  });
}

const { page } = Astro.props;
const { lang } = Astro.params;
const isFr = lang === 'fr';

// Fetch intro page entry
const allPages = await getCollection('pages');
const introPage = allPages.find(
  (entry) => entry.data.translationID === 'news' && (entry.data.lang || 'en') === lang
);

const { Content: IntroContent } = introPage ? await render(introPage) : { Content: null };

// Helper to extract image & clean text excerpt from Markdown/MDX post body
function processPostContent(body) {
  if (!body) return { image: null, excerpt: '' };

  let image = null;

  // 1. Check Markdown image: ![alt](src)
  const mdImgMatch = body.match(/!\[(.*?)\]\((.*?)\)/);
  
  // 2. Check HTML img tag: <img src="..." alt="...">
  const htmlImgMatch = body.match(/<img[^>]+src=["']([^"']+)["'][^>]*alt=["']([^"']*)["']/i) || 
                       body.match(/<img[^>]+alt=["']([^"']*)["'][^>]*src=["']([^"']+)["']/i);

  // 3. Check MDX import: import ImageName from '.../assets/images/...';
  const mdxImportMatch = body.match(/import\s+\w+\s+from\s+["']([^"']+\.(?:jpg|jpeg|png|webp|avif|svg))["']/i);

  let rawSrc = null;
  let altText = '';

  if (mdImgMatch) {
    rawSrc = mdImgMatch[2].trim();
    altText = mdImgMatch[1] || '';
  } else if (htmlImgMatch) {
    rawSrc = (htmlImgMatch[1].includes('/') ? htmlImgMatch[1] : htmlImgMatch[2]).trim();
    altText = htmlImgMatch[1].includes('/') ? htmlImgMatch[2] : htmlImgMatch[1];
  } else if (mdxImportMatch) {
    rawSrc = mdxImportMatch[1].trim();
    altText = '';
  }

  if (rawSrc) {
    const srcAssetPath = rawSrc.replace(/^.*\/assets\//, '/src/assets/');
    const matchedAsset = assetImages[srcAssetPath]?.default;

    if (matchedAsset) {
      image = { isAsset: true, src: matchedAsset, alt: altText };
    } else {
      const publicSrc = rawSrc.replace(/^.*\/assets\//, '/assets/');
      image = { isAsset: false, src: publicSrc, alt: altText };
    }
  }

  // Clean raw body for preview excerpt
  const cleanText = body
    .replace(/import\s+[\s\S]*?from\s+["'][^"']+["'];?/g, '') // Remove JS/MDX imports
    .replace(/^import\s+.*$/gm, '')                            // Fallback line import strip
    .replace(/^export\s+.*$/gm, '')                            // Remove export statements
    .replace(/<[A-Z][A-Za-z0-9]*\b[^>]*\/?>/g, '')             // Remove JSX components (<Picture />, etc.)
    .replace(/<\/[A-Z][A-Za-z0-9]*>/g, '')                     // Remove closing JSX tags
    .replace(/!\[.*?\]\(.*?\)/g, '')                           // Remove MD images
    .replace(/<img[^>]*>/gi, '')                               // Remove HTML img tags
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')                        // Keep link text from MD links
    .replace(/<[^>]+>/g, '')                                   // Remove remaining HTML tags
    .replace(/[#*`~_]/g, '')                                   // Remove markdown symbols
    .replace(/\s+/g, ' ')                                      // Normalize whitespace
    .trim();

  const excerpt = cleanText.length > 220 ? cleanText.slice(0, 220) + '...' : cleanText;

  return { image, excerpt };
}
---

<Layout 
  title={introPage?.data.title || "News and Updates"} 
  lang={lang} 
  translationID="news"
  pageEntry={introPage}
>
  {IntroContent && page.currentPage === 1 && (
    <div class="intro-section">
      <IntroContent components={{ a: AutoLink }}/>
      <br />
    </div>
  )}

  <section class="posts">
    <ul>
      {page.data.map((post, index) => {
        const rawDate = post.data.pubDate || (() => {
          const match = post.id.match(/^(\d{4}-\d{2}-\d{2})/);
          return match ? new Date(match[1]) : null;
        })();

        const formattedDate = rawDate
          ? new Intl.DateTimeFormat(isFr ? 'fr-FR' : 'en-US', { dateStyle: 'long' }).format(rawDate)
          : '';

        const { image, excerpt } = processPostContent(post.body);
        const animClass = index % 2 === 0 ? 'fadeOutLeft' : 'fadeOutRight';

        return (
          <li class={`fade ${animClass}`}>
            <AutoLink href={`/publications/${post.id}`} class="card-link linkoff">
              <div class="post-card">
                <h3>{post.data.title}</h3>
              </div>
              <div class="post-container">
                {formattedDate && (
                  <p>
                    <strong>{formattedDate}</strong>
                  </p>
                )}

                {post.data.usage === 'newsletter' ? (
                  <img 
                    src="/assets/images/email-icon.avif" 
                    alt={isFr ? "Image d'infolettre" : "Newsletter image"} 
                    class="newsletter-img" 
                  />
                ) : (
                  <>
                    {image && (
                      image.isAsset ? (
                        <Image 
                          src={image.src as ImageMetadata} 
                          alt={image.alt} 
                          class="post-img" 
                        />
                      ) : (
                        <img 
                          src={image.src as string} 
                          alt={image.alt} 
                          class="post-img" 
                        />
                      )
                    )}
                    {excerpt && <p>{excerpt}</p>}
                  </>
                )}

                <p class="link-p">
                  <span class="decorate_link">
                    {isFr ? 'lire la suite' : 'continue reading'}
                  </span>
                </p>
              </div>
            </AutoLink>
          </li>
        );
      })}
    </ul>
  </section>

  <br />
  <p class="center pagination-wrapper">
    {page.url.prev && <a href={page.url.prev} class="w3-button color-1-dark linkoff" style="color: var(--alert-text);margin: 0 12px;">«</a>}
    <span> Page {page.currentPage} / {page.lastPage} </span>
    {page.url.next && <a href={page.url.next} class="w3-button color-1-dark linkoff" style="color: var(--alert-text);margin: 0 12px;">»</a>}
  </p>
</Layout>

<style lang="scss">
  @use '../../../styles/_colors';

  .posts {
    padding: 1rem 0;
    width: min(calc(100vw - 2rem), 45em);
    margin-left: 50%;
    transform: translateX(-50%);

    > ul {
      display: grid;
      grid-template-columns: 1fr;
      grid-gap: 1.5rem;
      list-style-type: none;
      margin: auto;
      padding: 0;

      @media (min-width: 768px) {
        grid-template-columns: 1fr 1fr;
      }

      > li {
        position: relative;
        border-radius: 0.5rem;
        cursor: pointer;
        overflow: hidden;
        box-shadow: 0px 2px 2px rgba(0, 0, 0, var(--card-shadow));
        color: var(--body-text);
        display: flex;
        flex-direction: column;

        &:hover {
          box-shadow: 1px 3px 7px rgba(0, 0, 0, var(--card-shadow));
        }

        &::before {
          content: '';
          position: absolute;
          inset: 0;
          z-index: -3;
          background-color: var(--card-color);
        }

        &:hover .post-card h3::before {
          transform: translateX(0);
        }
      }
    }
  }

  .card-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
    background-image: none !important;
  }

  .post-card {
    position: relative;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background-color: var(--card-header);
    }

    h3 {
      position: relative;
      font-family: colors.$font-serif;
      background-color: transparent;
      text-align: center;
      margin: 0;
      padding: 15px;

      &::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background-color: var(--card-hover);
        transform: translateX(-100%);
        transition: transform 0.45s ease;
      }
    }
  }

  .post-container {
    width: 100%;
    padding: 15px;
    display: flex;
    flex-direction: column;
    flex: 1;

    p {
      text-indent: 0;
      margin-bottom: 0.75rem;
      line-height: 1.5;
    }

    p:first-child {
      margin-top: 0;
    }

    .post-img {
      max-height: 180px;
      width: auto;
      object-fit: contain;
      margin: 0.5rem auto 1rem;
      border-radius: 6px;
      display: block;
    }

    .newsletter-img {
      height: 90px;
      width: auto;
      margin: 0.5rem auto 1rem;
      display: block;
    }

    .link-p {
      margin-top: auto;
    }
  }
</style>

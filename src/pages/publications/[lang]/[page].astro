---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('blog');
  const languages = ['en', 'fr'];

  return languages.flatMap((lang) => {
    // Filter posts by language and sort by date
    const filteredPosts = allPosts
      .filter(post => post.data.lang === lang)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    // Generate paths for this language
    return paginate(filteredPosts, {
      params: { lang },
      pageSize: 5, // Number of posts per page
    });
  });
}

// All pagination data is passed via the "page" prop
const { page } = Astro.props;
const { lang } = Astro.params;
---

<Layout title={lang === 'fr' ? 'Publications' : 'Updates'} lang={lang}>
  <h1>{lang === 'fr' ? 'Nos Mises à Jour' : 'Latest Updates'}</h1>

  <ul>
    {page.data.map((post) => (
      <li>
        <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>

  <nav class="pagination">
    {page.url.prev ? <a href={page.url.prev}>&larr; Previous</a> : null}
    
    <span>Page {page.currentPage} of {page.lastPage}</span>

    {page.url.next ? <a href={page.url.next}>Next &rarr;</a> : null}
  </nav>
</Layout>

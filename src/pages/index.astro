---
const ogTitle = "Bienvenue / Welcome";
const siteUrl = "https://yourdomain.com";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{ogTitle}</title>
  <meta property="og:title" content={ogTitle} />
  <meta property="og:site_name" content="Montreal Quakers / Quakers de Montréal" />
  <meta property="og:image" content={`${siteUrl}/assets/images/quaker_icon.png`} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_CA" />
  <style>
    body { font-family: system-ui, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; text-align: center; }
    .container { max-width: 600px; padding: 20px; }
  </style>
  <script is:inline>
    (function() {
      const choice = localStorage.getItem('lang');
      if (choice === null || choice === "null") {
        window.location.replace("/bienvenue-welcome");
        return;
      }
      const redirects = { 'en': '/home', 'fr': '/accueil' };
      if (redirects[choice]) { window.location.replace(redirects[choice]); }
    })();
  </script>
</head>
<body>
  <div class="container">
    <noscript>
      <p>If you are not redirected automatically, <a href="/home">go to the home page</a>.</p>
      <p>Si votre navigateur ne vous redirige pas, <a href="/accueil">suivez ce lien vers l'accueil</a>.</p>
    </noscript>
    <p id="en-js"></p>
    <p id="fr-js"></p>
  </div>
  <script is:inline>
    setTimeout(() => {
      const en = document.getElementById("en-js");
      const fr = document.getElementById("fr-js");
      if(en) en.innerHTML = 'If you are not redirected automatically, <a href="/home">go to the home page</a>.';
      if(fr) fr.innerHTML = 'Si votre navigateur ne vous redirige pas, <a href="/accueil">suivez ce lien vers l\'accueil</a>.';
    }, 1500);
  </script>
</body>
</html>

---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="search-wrapper">
    <!-- Use a very specific ID -->
    <div id="pagefind-search-ui"></div>
  </div>

  <style is:global>
    :root { --pagefind-ui-width: 100%; }
    .search-wrapper { margin: 2rem 0; width: 100%; }
    .pagefind-ui__filter-value {
      display: none;
    }
  </style>

  <script>
    async function initPagefind() {
      if (document.querySelector('#pagefind-search-ui')) {
        if (typeof PagefindUI === 'undefined') {
          const script = document.createElement('script');
          script.src = '/pagefind/pagefind-ui.js';
          script.onload = () => {
            // 1. Initialize the UI
            // @ts-ignore
            const ui = new PagefindUI({
              element: "#pagefind-search-ui",
              autofocus: true,
              focusOnSlash: true,
              bundlePath: "/pagefind/",
              showImages: false,
              showFilters: true,
              showEmptyFilters: true,
              translations: {
                placeholder: "Press / to search"
              },
              filter: { 
                "language": document.documentElement.lang || "en" 
              }
            });

            // 2. NEW: Handle the URL query
            const urlParams = new URLSearchParams(window.location.search);
            const query = urlParams.get('q'); // Looks for ?q=your-search
            if (query) {
              ui.triggerSearch(query);
            }
          };
          document.head.appendChild(script);
          
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = '/pagefind/pagefind-ui.css';
          document.head.appendChild(link);
        }
      }
    }

    initPagefind();
    document.addEventListener('astro:after-swap', initPagefind);
  </script>
</Layout>




<style is:global>
  #pagefind-search-ui {
    /* Use the CSS variables already defined in your body/html */
    --pagefind-ui-primary: var(--color-1);
    --pagefind-ui-text: var(--body-text);
    --pagefind-ui-background: var(--body-bg);
    --pagefind-ui-border: var(--color-1-light);
    --pagefind-ui-tag: var(--color-1-light);
  }

  /* Target the results specifically to match your serif headers */
  #pagefind-search-ui .pagefind-ui__result-title,
  #pagefind-search-ui .pagefind-ui__result-link {
    font-family: "Crimson Pro", serif; /* Replace with your actual serif name */
    font-weight: 600;
    color: var(--color-1) !important;
  }

  /* Fix the search input background for dark mode */
  .darkmode #pagefind-search-ui .pagefind-ui__search-input {
    background-color: var(--body-bg);
    color: var(--body-text);
    border: 1px solid var(--color-1);
  }

  /* Match your highlight color to your theme selection color */
  #pagefind-search-ui mark {
    background-color: var(--color-1);
    color: var(--alert-text);
    border-radius: 2px;
    padding: 0 2px;
  }
  #pagefind-search-ui .pagefind-ui__filter-checkbox:checked {
    background-color: var(--color-1);
    border-color: var(--color-1-dark);
  }
</style>

---
// src/layout/Layout.astro
import { Icon } from 'astro-icon/components';
import { fade } from 'astro:transitions';
import Head from '../components/Head.astro';
import Navigation from '../components/Navigation.astro';
import CodeAlert from '../components/navigation/CodeAlert.astro';
import AngleCircleArrowUp from '../components/navigation/AngleCircleArrowUp.svg';
// For the footer markdown files:
import Footer from '../components/navigation/Footer.astro';
import { MEDIA_PAGES,BREAKPOINTS } from '../consts';
import MediaDispatcher from '../components/MediaDispatcher.astro';

// 2. Map the Jekyll "page" and "site" variables
const { 
  title, 
  description, 
  lang = 'en', 
  translationID, 
  series,
  usage, 
  type, 
  pageIconRight, 
  pageIconRightClass, 
  pageIconLeft, 
  pageIconLeftClass,
  mediaContent 
} = Astro.props;

// 3. Handle Bilingual Logic
const isFr = lang === "fr";
const returntoTopText = isFr ? "Retour en haut" : "Return to top";
const pageMedia = MEDIA_PAGES.find(p => p.tid === translationID);
---

<!DOCTYPE html>
<html lang={lang}>
  <Head /> 
  <body id="toppoint" data-pagefind-filter={`language:${lang}`}>
    <script>
      import "../assets/js/darkmode.js"
      import "../assets/js/navigation.js"
    </script>   

    <Navigation 
      lang={lang} 
      translationID={translationID} 
      series={series} 
      pageIconLeft={pageIconLeft} 
      pageIconRight={pageIconRight}
      breakpoints={BREAKPOINTS.desktop}
      transition:persist
    />

    <section class="alert-code">
      <CodeAlert lang={lang} translationID={translationID} />
    </section>

    
<section class="page-title-header">
      {!(translationID === "home" || usage === "newsletter") && (
        <>
          {title && (
            <>
              <br />
              <h1 class="header">
                {pageIconLeft && (
                  <Icon 
                    name={pageIconLeft} 
                    class={pageIconLeftClass || 'color-1-dark-text'} 
                    style="display: inline-block; vertical-align: middle; margin-right: 0.3em; width: 1em; height: 1em;"
                  />
                )}
                {title}
                {pageIconRight && (
                  <Icon 
                    name={pageIconRight} 
                    class={pageIconRightClass || 'color-1-dark-text'} 
                    style="display: inline-block; vertical-align: middle; margin-left: 0.3em; width: 1em; height: 1em;"
                  />
                )}
              </h1>
            </>
          )}
          {description && (
            <h2 class="header">{description}</h2>
          )}
        </>
      )}
    </section>

    <main transition:animate={fade({ duration: '0.08s'})}>
      <br class="widespace" />

      <a 
        href="#toppoint" 
        aria-label={returntoTopText} 
        id="topBtn" 
        class="topBtn" 
        title={returntoTopText}
      >
        <AngleCircleArrowUp />
      </a>

      <article class="container-content">
        {translationID !== "calendar" && (
          <div class="content">
            <slot />
            <br />
          </div>
        )}

        {pageMedia && (
          <div class="media" id="media">
            <MediaDispatcher mediaName={pageMedia.media} />
          
            {pageMedia.media2 && <MediaDispatcher mediaName={pageMedia.media2} />}
          </div>
        )}
      </article>
    </main>

    <br />&nbsp; 

    
    <footer class="footer" transition:persist>
      <Footer lang={lang} />
    </footer>

  </body>
</html>
